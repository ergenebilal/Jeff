{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybergene.local/schemas/task-contract.schema.json",
  "title": "Jeff Pablo Task Contract",
  "type": "object",
  "required": [
    "task_id", "created_at", "updated_at", "source", "goal", "success_criteria", "risk_level",
    "side_effect_class", "approval_required", "input_digest",
    "status", "attempt", "max_attempts"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "actor_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "side_effect_class": {"enum": ["none", "local", "reversible", "external", "irreversible"]},
    "approval_required": {"type": "boolean"},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assigned_worker": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "steps": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "required": ["name", "kind", "content", "format"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "kind": {"const": "artifact_write"},
          "content": {"type": "string", "minLength": 1, "maxLength": 500000},
          "format": {"enum": ["txt", "md", "json"]}
        },
        "additionalProperties": false
      }
    },
    "lease_owner": {"type": ["string", "null"]},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "enum": ["received", "planned", "queued", "claimed", "running", "waiting_approval", "reconciling", "verifying", "verified", "failed", "escalated", "cancelled"]
    },
    "approval_id": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "verification_result": {"type": ["object", "null"]},
    "final_result": {"type": ["object", "string", "null"]},
    "failure_reason": {"type": ["string", "null"]},
    "rollback_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
