#!/bin/bash
# Autonomous Health Check Script — v2
# Checks system resources, Docker containers, services, and network
# Output: STATUS: CRITICAL|HIGH|WARNING|OK
# Created: 2026-08-17

CRITICAL=0
HIGH=0
WARNING=0
ISSUES=()

log() { echo "$1"; }

http_code() {
    local code
    code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10 "$1" 2>/dev/null)
    [ -z "$code" ] && code="000"
    echo "$code"
}

check_cpu_load() {
    local cores=$(nproc)
    local load=$(awk '{print $1}' /proc/loadavg)
    local load_int=${load%%.*}
    if [ "$load_int" -gt $((cores * 2)) ]; then
        log "🔴 CRITICAL: CPU load $load on $cores cores"
        ISSUES+=("CPU overloaded: $load"); CRITICAL=$((CRITICAL + 1))
    elif [ "$load_int" -gt "$cores" ]; then
        log "🟡 HIGH: CPU load $load on $cores cores"
        ISSUES+=("CPU high: $load"); HIGH=$((HIGH + 1))
    else
        log "🟢 CPU: load $load / $cores cores — OK"
    fi
}

check_memory() {
    local total=$(free -m | awk '/Mem:/{print $2}')
    local used=$(free -m | awk '/Mem:/{print $3}')
    local pct=$((used * 100 / total))
    if [ "$pct" -gt 90 ]; then
        log "🔴 CRITICAL: Memory ${pct}% used (${used}M/${total}M)"
        ISSUES+=("Memory critical: ${pct}%"); CRITICAL=$((CRITICAL + 1))
    elif [ "$pct" -gt 80 ]; then
        log "🟡 HIGH: Memory ${pct}% used (${used}M/${total}M)"
        ISSUES+=("Memory high: ${pct}%"); HIGH=$((HIGH + 1))
    elif [ "$pct" -gt 70 ]; then
        log "🟠 WARNING: Memory ${pct}% used (${used}M/${total}M)"
        WARNING=$((WARNING + 1))
    else
        log "🟢 Memory: ${pct}% used — OK"
    fi
}

check_disk() {
    local pct=$(df / | tail -1 | awk '{print $5}' | tr -d '%')
    if [ "$pct" -gt 90 ]; then
        log "🔴 CRITICAL: Disk ${pct}% full"
        ISSUES+=("Disk critical: ${pct}%"); CRITICAL=$((CRITICAL + 1))
    elif [ "$pct" -gt 80 ]; then
        log "🟡 HIGH: Disk ${pct}% full"
        ISSUES+=("Disk high: ${pct}%"); HIGH=$((HIGH + 1))
    elif [ "$pct" -gt 70 ]; then
        log "🟠 WARNING: Disk ${pct}% full"
        WARNING=$((WARNING + 1))
    else
        log "🟢 Disk: ${pct}% used — OK"
    fi
}

check_docker() {
    local running=$(docker ps --format "{{.Names}}" 2>/dev/null | wc -l)
    local stopped=$(docker ps -a --filter "status=exited" --format "{{.Names}}" 2>/dev/null | wc -l)
    
    for svc in n8n hermes-vm coolify beszel; do
        local status=$(docker inspect --format '{{.State.Status}}' "$svc" 2>/dev/null || echo "not_found")
        if [ "$status" != "running" ]; then
            log "🔴 CRITICAL: Container '$svc' is $status"
            ISSUES+=("Container $svc: $status"); CRITICAL=$((CRITICAL + 1))
        fi
    done
    log "🟢 Docker: $running running, $stopped exited"
}

check_n8n() {
    local code=$(http_code "http://localhost:5678")
    if [ "$code" = "000" ] || [ "$code" = "502" ] || [ "$code" = "503" ]; then
        log "🔴 CRITICAL: n8n localhost:5678 unreachable (HTTP $code)"
        ISSUES+=("n8n unreachable"); CRITICAL=$((CRITICAL + 1))
    else
        log "🟢 n8n: localhost:5678 responding (HTTP $code) — OK"
    fi
}

check_websites() {
    for url in "https://ergeneai.com" "https://google.com"; do
        local code=$(http_code "$url")
        if [ "$code" = "000" ]; then
            log "🔴 HIGH: $url unreachable"
            ISSUES+=("$url unreachable"); HIGH=$((HIGH + 1))
        else
            log "🟢 $url: HTTP $code — OK"
        fi
    done
}

check_services() {
    # caddy is intentionally masked (nginx replaced it) — skip
    # certbot is intentionally DISABLED (acme.sh replaced it since JEFF-OPT-MASTER-010) — skip
    # SSL renewal is handled by acme.sh daily cron — verify that instead:
    if ! crontab -l 2>/dev/null | grep -q "acme.sh"; then
        log "🟡 HIGH: acme.sh daily cron missing — SSL auto-renewal may be broken"
        ISSUES+=("acme.sh cron missing"); HIGH=$((HIGH + 1))
    else
        log "🟢 acme.sh cron: active — OK"
    fi
    
    local claude_ok=true
    if systemctl is-active claude-proxy-watchdog.service 2>/dev/null | grep -q "failed"; then
        log "🟠 WARNING: claude-proxy-watchdog failed"
        WARNING=$((WARNING + 1)); claude_ok=false
    fi
    
    local other_fails=$(systemctl --failed --no-legend 2>/dev/null | grep -c "failed" || true)
    # subtract known failures (certbot + claude-proxy if they exist)
    if [ "$claude_ok" = false ]; then other_fails=$((other_fails - 1)); fi
    if [ "$other_fails" -gt 0 ]; then
        log "🟠 WARNING: $other_fails additional failed service(s)"
        WARNING=$((WARNING + 1))
    fi
    
    if [ "$HIGH" -eq 0 ] && [ "$CRITICAL" -eq 0 ]; then
        log "🟢 System services: OK"
    fi
}

check_oom() {
    local oom=$(dmesg 2>/dev/null | grep -ci "oom\|out of memory" || true)
    if [ "$oom" -gt 0 ]; then
        log "🟡 HIGH: $oom OOM events detected"
        ISSUES+=("OOM kills: $oom"); HIGH=$((HIGH + 1))
    else
        log "🟢 OOM: none — OK"
    fi
}

check_disk_errors() {
    local errs=$(dmesg 2>/dev/null | grep -ci "I/O error\|disk.*fail" || true)
    if [ "$errs" -gt 5 ]; then
        log "🟡 HIGH: $errs disk/IO errors in dmesg"
        ISSUES+=("Disk errors: $errs"); HIGH=$((HIGH + 1))
    else
        log "🟢 Disk errors: $errs — OK"
    fi
}

# === MAIN ===
LOG_FILE=/home/hermes/reports/autonomous-health.log
{
echo "=== AUTONOMOUS HEALTH CHECK — $(date '+%Y-%m-%d %H:%M:%S %Z') ==="
echo ""
check_cpu_load
check_memory
check_disk
check_docker
check_n8n
check_websites
check_services
check_oom
check_disk_errors

echo ""
echo "=== SUMMARY ==="
echo "CRITICAL: $CRITICAL | HIGH: $HIGH | WARNING: $WARNING"
} >> "$LOG_FILE" 2>&1

# Sessiz mod: CRITICAL/HIGH ise stdout'a kısa özet (delivery tetiklenir), değilse boş (sessiz)
if [ "$CRITICAL" -gt 0 ]; then
    echo "🔴 AUTONOMOUS HEALTH: CRITICAL ($CRITICAL) — ${ISSUES[*]}"
    exit 2
elif [ "$HIGH" -gt 0 ]; then
    echo "🟡 AUTONOMOUS HEALTH: HIGH ($HIGH) — ${ISSUES[*]}"
    exit 1
fi
# OK / WARNING → boş stdout = sessiz, delivery yok
exit 0
