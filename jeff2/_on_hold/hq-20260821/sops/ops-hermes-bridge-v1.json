        "language": "javaScript",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst cooldownMs = 5 * 60 * 1000; // 5dk dedup\nconst input = $input.first()?.json ?? {};\nconst body = input.body ?? input;\nconst event = body.event || input.event || '';\nconst tool = body.tool || input.tool || body.tool_name || input.tool_name || '';\nconst session = body.session || input.session || body.session_id || input.session_id || body.sessionId || '';\nconst timestamp = body.timestamp || input.timestamp || new Date().toISOString();\nconst dedupKey = `${event}:${tool}:${session}`;\nif (!event) {\n  return [{ json: { event, tool, session, timestamp, shouldForward: false, reason: 'missing_event', dedupKey } }];\n}\nif (staticData[dedupKey] && (now - staticData[dedupKey] < cooldownMs)) {\n  return [{ json: { event, tool, session, timestamp, shouldForward: false, reason: 'dedup', dedupKey, lastTs: staticData[dedupKey], now } }];\n}\nstaticData[dedupKey] = now;\nreturn [{ json: { event, tool, session, timestamp, shouldForward: true, dedupKey, now } }];\n"
      },
