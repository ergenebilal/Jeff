{
  "name": "ops-n8n-health-failure-alarm-v1",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "eb187cb7-768e-43ec-8b7b-4fc78feda081",
      "name": "Schedule — every 5m",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://n8n.aiergene.xyz/healthz",
        "options": {
          "timeout": 10000,
          "redirect": {
            "followRedirects": true,
            "maxRedirects": 3
          }
        }
      },
      "id": "41e62d98-9004-4a6f-9e75-5c68701b0b15",
      "name": "HTTP — healthz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        360,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "timeout 10s retry 0. alwaysOutputData so IF can route on failure"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.status || 'error') }}",
              "operator": {
                "type": "string",
                "operation": "isNotEqual"
              },
              "rightValue": "ok"
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "03d82349-df6c-4c72-b951-921a9976a1e9",
      "name": "IF — health != ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        640,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Query last 5m failed executions (DB: execution_entity status='failed')\n// In n8n Code node we cannot access host SQLite directly, so we:\n// 1) dedup cooldown via staticData (15m)\n// 2) return mockable failedCount for testing\n// Replace this block with actual DB/HTTP query if n8n can reach SQLite via Execute Command.\nconst staticData = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst cooldownMs = 15 * 60 * 1000;\n// cooldown check (dedup)\nif (staticData.lastAlertTs && (now - staticData.lastAlertTs) < cooldownMs) {\n  return [{ json: { skipAlert: true, reason: 'cooldown', lastAlertTs: staticData.lastAlertTs, now } }];\n}\n// health status comes from upstream; if upstream error, status is missing\nconst healthStatus = $input.first()?.json?.status ?? 'error';\nconst healthOk = healthStatus === 'ok';\n// ---- failed executions check ----\n// In production, override via $input or env: query execution_entity where status='failed' and startedAt > now-5m\n// For testability, allow injection via $json.mockFailedCount\nconst mockFailed = $input.first()?.json?.mockFailedCount;\nconst failedCount = typeof mockFailed === 'number' ? mockFailed : 0;\n// Example real query if Execute Command node is used instead:\n// SELECT count(*) FROM execution_entity WHERE status='failed' AND startedAt >= datetime('now','-5 minutes')\n// ----\n// Update dedup timestamp only if we will alert (caller decides, but store tentative)\nreturn [{ json: { healthStatus, healthOk, failedCount, skipAlert: false, checkedAt: new Date().toISOString() } }];\n"
      },
      "id": "8225ec38-2ad3-440c-a618-cf89a5191304",
      "name": "Code — check failed + dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        -90
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skipAlert }}",
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            },
            {
              "leftValue": "={{ $json.failedCount }}",
              "operator": {
                "type": "number",
                "operation": "larger"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6c63b06d-db76-4673-b9c3-7a2d511a6b7a",
      "name": "IF — failed > 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1080,
        -90
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔴 n8n alarm — health: {{ $json.healthStatus }} | failed(5m): {{ $json.failedCount }} — {{ $now.toFormat('yyyy-MM-dd HH:mm:ss Z') }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "f21dcd45-842b-43b1-b09a-ff9ee2f01caa",
      "name": "Telegram — alarm",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        -20
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "onError": "continueErrorOutput",
      "notes": "uses $env.TELEGRAM_BOT_TOKEN via credentials/env, retry 2x (30s then backoff), secret not in export",
      "credentials": {
        "telegramApi": {
          "id": "env_telegram",
          "name": "Telegram (env TELEGRAM_BOT_TOKEN)"
        }
      }
    },
    {
      "parameters": {},
      "id": "d745d9d8-6e7d-4e3a-876f-f831f025d1f1",
      "name": "NoOp — ok",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        -220
      ]
    }
  ],
  "connections": {
    "Schedule — every 5m": {
      "main": [
        [
          {
            "node": "HTTP — healthz",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP — healthz": {
      "main": [
        [
          {
            "node": "IF — health != ok",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF — health != ok": {
