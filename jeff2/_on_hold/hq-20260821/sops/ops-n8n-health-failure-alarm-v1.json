            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Code — check failed + dedup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code — check failed + dedup": {
      "main": [
        [
          {
            "node": "IF — failed > 0",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF — failed > 0": {
      "main": [
        [
          {
            "node": "Telegram — alarm",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "NoOp — ok",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "staticData": null,
  "meta": {
    "instanceId": "n8n.aiergene.xyz",
    "exportNote": "secret-free export; Telegram uses $env.TELEGRAM_BOT_TOKEN via credential id env_telegram"
  },
  "pinData": {},
  "versionId": "652fb7e3-0419-4aad-b24d-e9452fccaa1d",
  "active": false,
  "description": "LOW risk — n8n healthz + last-5m failed executions alarm. Schedule */5m, inactive. Telegram via $env.TELEGRAM_BOT_TOKEN, 15m dedup cooldown, retry 2x."
