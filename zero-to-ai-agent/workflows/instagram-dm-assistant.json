        "functionCode": "const d = $input.first().json||{};\nif(d.query&&d.query['hub.mode']) return [{json:{challenge:d.query['hub.challenge']}}];\nconst data = d.body||d; let s='',m='';\nif(data.entry&&data.entry[0]&&data.entry[0].messaging&&data.entry[0].messaging[0]){\n  s=data.entry[0].messaging[0].sender.id; m=data.entry[0].messaging[0].message.text;\n} else { s=data.senderId||''; m=data.text||data.message||''; }\nreturn [{json:{senderId:s||'',messageText:m||'',skip:!s||!m}}];"
      }
