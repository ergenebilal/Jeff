{
  "name": "Secure Webhook Proxy (Auth + Multi-Channel)",
  "nodes": [
    {
      "id": "wf04-node01",
      "name": "Webhook Receiver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.2,
      "position": [250, 300],
      "parameters": {
        "path": "secure-proxy",
        "methods": ["POST"],
        "authentication": "none",
        "responseMode": "responseNode",
        "options": { "responseHeaders": { "entries": [{"name": "X-Request-Id", "value": "={{ $json._webhook_id }}"}] } }
      }
    },
    {
      "id": "wf04-node02",
      "name": "API Key Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2.0,
      "position": [450, 300],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst expectedKey = $env.API_KEY || $env.WEBHOOK_SECRET || 'YOUR_SECRET_KEY_HERE';\nconst providedKey = raw.headers?.['x-api-key'] || raw.headers?.['authorization']?.replace('Bearer ', '') || raw.api_key;\n\nif (!providedKey || providedKey !== expectedKey) {\n  return [{\n    json: {\n      status: 'error',\n      code: 401,\n      message: 'Invalid or missing API key'\n    }\n  }];\n}\n\nconst cleanBody = { ...raw.body };\nconst metadata = {\n  source_ip: raw.headers?.['x-forwarded-for'] || raw.headers?.['x-real-ip'] || 'unknown',\n  user_agent: raw.headers?.['user-agent'] || 'unknown',\n  content_type: raw.headers?.['content-type'] || 'application/json',\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: { payload: cleanBody, metadata, channel: raw.body?.channel || 'default' } }];"
      }
    },
    {
      "id": "wf04-node03",
      "name": "Data Transformation",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2.0,
      "position": [650, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "title", "value": "={{ $json.payload?.title || $json.payload?.subject || 'Notification' }}" },
            { "name": "message", "value": "={{ $json.payload?.message || $json.payload?.text || $json.payload?.body || '' }}" },
            { "name": "severity", "value": "={{ $json.payload?.severity || $json.payload?.priority || 'info' }}" },
            { "name": "source", "value": "={{ $json.metadata?.source_ip || 'unknown' }}" },
            { "name": "sent_at", "value": "={{ $json.metadata?.timestamp }}" }
          ]
        },
        "options": { "includeOtherFields": true }
      }
    },
    {
      "id": "wf04-node04",
      "name": "Channel Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2.0,
      "position": [850, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.channel }}",
        "rules": [
          { "value1": "slack", "outputKey": "slack" },
          { "value1": "discord", "outputKey": "discord" },
          { "value1": "telegram", "outputKey": "telegram" }
        ],
        "fallbackOutputKey": "default"
      }
    },
    {
      "id": "wf04-node05",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1050, 150],
      "parameters": {
        "operation": "postMessage",
        "channelId": "={{ $json.payload?.slack_channel || '#notifications' }}",
        "text": "*{{ $json.title }}*\n{{ $json.message }}\n_Severity: {{ $json.severity }}_"
      }
    },
    {
      "id": "wf04-node06",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 350],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.payload?.discord_webhook_url || 'YOUR_DISCORD_WEBHOOK_URL' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "content", "value": "={{ '**' + $json.title + '**\\n' + $json.message }}" },
            { "name": "username", "value": "Webhook Proxy" }
          ]
        }
      }
    },
    {
      "id": "wf04-node07",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2.1,
      "position": [1050, 550],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.payload?.telegram_chat || $env.TELEGRAM_CHAT_ID }}",
        "text": "*{{ $json.title }}*\n{{ $json.message }}"
      }
    },
    {
      "id": "wf04-node08",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.0,
      "position": [1250, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"delivered\",\"timestamp\":\"{{ new Date().toISOString() }}\",\"channels\":[\"{{ $json.channel || 'default' }}\"]}"
      }
    }
  ],
  "connections": {
    "Webhook Receiver": { "main": [[{"node": "API Key Validation", "type": "main", "index": 0}]] },
    "API Key Validation": { "main": [[{"node": "Data Transformation", "type": "main", "index": 0}]] },
    "Data Transformation": { "main": [[{"node": "Channel Router", "type": "main", "index": 0}]] },
    "Channel Router": {
      "main": [
        [{"node": "Send to Slack", "type": "main", "index": 0}],
        [{"node": "Send to Discord", "type": "main", "index": 0}],
        [{"node": "Send to Telegram", "type": "main", "index": 0}],
        [{"node": "Send to Slack", "type": "main", "index": 0}]
      ]
    },
    "Send to Slack": { "main": [[{"node": "Respond 200 OK", "type": "main", "index": 0}]] },
    "Send to Discord": { "main": [[{"node": "Respond 200 OK", "type": "main", "index": 0}]] },
    "Send to Telegram": { "main": [[{"node": "Respond 200 OK", "type": "main", "index": 0}]] }
  },
  "settings": { "executionOrder": "v1" }
}
